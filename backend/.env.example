# MEDUSA-X backend configuration.
# Copy to backend/.env and fill in the values you need. Never commit real keys.

# --- Model layer (optional) -------------------------------------------------
# Without a key MEDUSA-X still runs end to end: extraction, reconciliation,
# evidence verification, timeline and summary are deterministic and evidence
# based. With a key the OpenAI Agents SDK layer additionally drives the
# specialist agents and chooses which tools to call.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# --- Persistence ------------------------------------------------------------
# SQLite by default; the file and document store are created on startup.
DATABASE_PATH=
STORAGE_DIR=

# --- Datasets ---------------------------------------------------------------
# Root that contains one folder per dataset (synthea, ekacare_parsing, ...).
DATASET_DIR=

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase (optional, not required for the prototype) --------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Bounded agent execution ------------------------------------------------
MAX_AGENT_TURNS=14
MAX_SPECIALIST_RETRIES=1
AGENT_TIMEOUT_SECONDS=180
